# Sales, purchases, deliveries and stock adjustments use multi-document
# transactions, which MongoDB only supports on a replica set or mongos router.
# A plain `mongodb://localhost:27017/...` standalone instance will fail with
# "Transaction numbers are only allowed on a replica set member or mongos"
# as soon as you try to record a sale. Use one of:
#   - MongoDB Atlas (free tier is a replica set by default), or
#   - a local instance started with `mongod --replSet rs0` (run
#     `rs.initiate()` once via `mongosh` after starting it)
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/product-management
# Required. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=604800
